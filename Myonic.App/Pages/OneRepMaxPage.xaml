<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.OneRepMaxPage"
             x:DataType="vm:OneRepMaxViewModel"
             Title="Калькулятор 1ПМ">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,36" Spacing="20">

            <!-- ================= SECTION 1: 1RM CALCULATOR ================= -->
            <Label Text="Калькулятор повторного максимума (1ПМ)"
                   FontFamily="OpenSansSemibold"
                   FontSize="19" />
            <Label Text="Введите вес (от 20 до 500 кг) и количество повторений, затем нажмите «Рассчитать 1ПМ»."
                   FontSize="13" />

            <!-- Weight and Reps Inputs -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Вес снаряда, кг" FontFamily="OpenSansSemibold" />
                    <Entry Text="{Binding WeightText}"
                           Keyboard="Numeric"
                           Placeholder="От 20 до 500" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Повторения (1–12)" FontFamily="OpenSansSemibold" />
                    <Picker ItemsSource="{Binding RepOptions}"
                            SelectedIndex="{Binding SelectedRepsIndex}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Calculate Button -->
            <Button Text="Рассчитать 1ПМ"
                    Command="{Binding CalculateCommand}"
                    Margin="0,4,0,0" />

            <!-- Results Section (Visible only when calculated) -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasResult}">

                <!-- Low accuracy warning -->
                <Label Text="⚠️ При более чем 10 повторениях точность формул снижается."
                       IsVisible="{Binding IsLowAccuracy}"
                       FontSize="12"
                       TextColor="DarkOrange" />

                <Label Text="Результаты по формулам"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       Margin="0,4,0,0" />

                <!-- Formulas list -->
                <CollectionView ItemsSource="{Binding FormulaResults}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormulaResultItem">
                            <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding FormulaName}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ValueText}"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Average Section at the end of the formulas list -->
                <Grid Padding="12" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="Среднее значение"
                           FontFamily="OpenSansSemibold"
                           FontSize="17"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding AverageText}"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- ================= SECTION 2: PERCENTAGE CALCULATOR ================= -->
            <BoxView HeightRequest="1" Margin="0,8" Color="LightGray" />

            <Label Text="Калькулятор рабочих процентов"
                   FontFamily="OpenSansSemibold"
                   FontSize="19" />
            <Label Text="Рассчитайте необходимый вес для тренировочного подхода от 1ПМ или 5ПМ."
                   FontSize="13" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Базовый вес, кг" FontFamily="OpenSansSemibold" />
                    <Entry Text="{Binding PercentWeightText}"
                           Keyboard="Numeric"
                           Placeholder="От 20 до 500" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="База расчёта" FontFamily="OpenSansSemibold" />
                    <Picker ItemsSource="{Binding BaseTypeOptions}"
                            SelectedIndex="{Binding BaseTypeIndex}" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Быстрый выбор %" FontFamily="OpenSansSemibold" />
                    <Picker ItemsSource="{Binding PresetPercentOptions}"
                            SelectedIndex="{Binding SelectedPresetPercentIndex}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Процент, %" FontFamily="OpenSansSemibold" />
                    <Entry Text="{Binding PercentageText}"
                           Keyboard="Numeric"
                           Placeholder="Например, 80" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="Рассчитать процент"
                    Command="{Binding CalculatePercentageCommand}"
                    Margin="0,4,0,0" />

            <!-- Percentage Result -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPercentResult}" Margin="0,4,0,0">
                <Grid Padding="14" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding PercentDetailText}"
                           VerticalOptions="Center"
                           FontSize="15" />
                    <Label Grid.Column="1"
                           Text="{Binding PercentResultText}"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
