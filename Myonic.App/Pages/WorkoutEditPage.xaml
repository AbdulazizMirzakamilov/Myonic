<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Myonic.Pages.WorkoutEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Myonic.ViewModels"
    Title="Тренировка"
    x:DataType="vm:WorkoutEditViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Название" />
            <Entry Placeholder="Например, Грудь + трицепс" Text="{Binding Name}" />

            <Label Margin="0,8,0,0" Text="День недели по умолчанию" />
            <Picker ItemsSource="{Binding DayOptions}" SelectedIndex="{Binding DayIndex}" />

            <Button
                Margin="0,16,0,0"
                Command="{Binding SaveCommand}"
                Text="Сохранить" />
            <Button
                BackgroundColor="Firebrick"
                Command="{Binding DeleteCommand}"
                Text="Удалить тренировку" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>