<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.WorkoutEditPage"
             x:DataType="vm:WorkoutEditViewModel"
             Title="Тренировка">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

        <VerticalStackLayout Spacing="8">
            <Label Text="Название" />
            <Entry Text="{Binding Name}" Placeholder="Например, Грудь + трицепс" />

            <Label Text="День недели по умолчанию" Margin="0,8,0,0" />
            <Picker ItemsSource="{Binding DayOptions}" SelectedIndex="{Binding DayIndex}" />

            <Button Text="Сохранить" Command="{Binding SaveCommand}" Margin="0,8,0,0" />
            <Button Text="Удалить тренировку" Command="{Binding DeleteCommand}"
                    BackgroundColor="Firebrick" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Label Text="Упражнения" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Добавить" Command="{Binding AddExerciseCommand}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Exercises}">
            <CollectionView.EmptyView>
                <Label Text="Упражнений пока нет" HorizontalOptions="Center" Margin="0,16" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlannedExerciseItem">
                    <Border Padding="12" Margin="0,4" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutEditViewModel}}, Path=OpenExerciseCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding PlanText}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="▲" WidthRequest="44" Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutEditViewModel}}, Path=MoveUpCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="▼" WidthRequest="44" Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutEditViewModel}}, Path=MoveDownCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>