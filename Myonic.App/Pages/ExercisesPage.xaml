<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:conv="clr-namespace:Myonic.Converters"
             x:Class="Myonic.Pages.ExercisesPage"
             x:DataType="vm:ExercisesViewModel"
             x:Name="ThisPage"
             Title="Упражнения"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:SwitcherBgColorConverter x:Key="SwitcherBgColorConverter" />
            <conv:SwitcherTextColorConverter x:Key="SwitcherTextColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="{OnIdiom Phone='16,12,16,20', Desktop='28,20,28,30'}"
          RowSpacing="10">

        <!-- 1. Header with Title and Add Button -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="БАЗА УПРАЖНЕНИЙ"
                       TextColor="{DynamicResource KineticTextMuted}"
                       FontSize="11"
                       FontAttributes="Bold" />
                <Label Text="Библиотека движений"
                       TextColor="{DynamicResource KineticText}"
                       FontSize="20"
                       FontAttributes="Bold" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="+ Добавить"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource VoltButton}"
                    HeightRequest="38"
                    Padding="14,0"
                    FontSize="12" />
        </Grid>

        <!-- 2. Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource KineticWell}"
                Stroke="{DynamicResource KineticBorderSubtle}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="6,2">
            <SearchBar Placeholder="Поиск по названию..."
                       PlaceholderColor="{DynamicResource KineticTextMuted}"
                       TextColor="{DynamicResource KineticText}"
                       BackgroundColor="Transparent"
                       Text="{Binding SearchText}" />
        </Border>

        <!-- 3. Category Filter Chips (Type) + Count Badge -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Border BackgroundColor="{DynamicResource KineticWell}"
                    Stroke="{DynamicResource KineticBorderSubtle}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="3">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="4">
                    <!-- Filter All -->
                    <Border BackgroundColor="{Binding IsAllFilter, Converter={StaticResource SwitcherBgColorConverter}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <Label Text="Все типы"
                               TextColor="{Binding IsAllFilter, Converter={StaticResource SwitcherTextColorConverter}}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Filter Compound -->
                    <Border Grid.Column="1"
                            BackgroundColor="{Binding IsCompoundFilter, Converter={StaticResource SwitcherBgColorConverter}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="1" />
                        </Border.GestureRecognizers>
                        <Label Text="Базовые"
                               TextColor="{Binding IsCompoundFilter, Converter={StaticResource SwitcherTextColorConverter}}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Filter Isolation -->
                    <Border Grid.Column="2"
                            BackgroundColor="{Binding IsIsolationFilter, Converter={StaticResource SwitcherBgColorConverter}}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="2" />
                        </Border.GestureRecognizers>
                        <Label Text="Изолирующие"
                               TextColor="{Binding IsIsolationFilter, Converter={StaticResource SwitcherTextColorConverter}}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Total count label -->
            <Label Grid.Column="1"
                   Text="{Binding CountText}"
                   TextColor="{DynamicResource KineticTextMuted}"
                   FontSize="12"
                   HorizontalOptions="End"
                   VerticalOptions="Center" />
        </Grid>

        <!-- 4. Muscle Group Filter Chips (Horizontal Scroll) -->
        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,0,0,2">
            <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding MuscleGroupFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MuscleGroupFilterItem">
                        <Border StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Padding="12,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource KineticWell}" />
                                    <Setter Property="Stroke" Value="{DynamicResource KineticBorderSubtle}" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#1A3300" />
                                            <Setter Property="Stroke" Value="{DynamicResource KineticVolt}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectMuscleGroupCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}"
                                   FontSize="12"
                                   FontAttributes="Bold">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="{DynamicResource KineticTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource KineticVolt}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 5. Exercises List -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Exercises}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24,36"
                        Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🔍" FontSize="36" HorizontalTextAlignment="Center" />
                        <Label Text="Упражнения не найдены"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Попробуйте изменить поисковый запрос или фильтры, либо добавьте новое упражнение."
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                        <Button Text="+ Добавить упражнение"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource VoltButton}"
                                HeightRequest="44"
                                Padding="18,0"
                                Margin="0,8,0,0"
                                FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExerciseListItem">
                    <Border BackgroundColor="{DynamicResource KineticSurface}"
                            Stroke="{DynamicResource KineticBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,10"
                            Margin="0,3">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <!-- Exercise info & badges -->
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       TextColor="{DynamicResource KineticText}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <!-- Muscle Group Badge -->
                                    <Border BackgroundColor="{DynamicResource KineticWell}"
                                            Stroke="{DynamicResource KineticBorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            IsVisible="{Binding HasMuscleGroup}">
                                        <Label Text="{Binding MuscleGroupText}"
                                               TextColor="{DynamicResource KineticIceBlue}"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Undefined Muscle Group Badge -->
                                    <Border BackgroundColor="{DynamicResource KineticWell}"
                                            Stroke="{DynamicResource KineticBorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2"
                                            IsVisible="{Binding HasNoMuscleGroup}">
                                        <Label Text="Без группы"
                                               TextColor="{DynamicResource KineticTextMuted}"
                                               FontSize="10" />
                                    </Border>

                                    <!-- Type badge -->
                                    <Border BackgroundColor="{DynamicResource KineticWell}"
                                            Stroke="{DynamicResource KineticBorderSubtle}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,2">
                                        <Label Text="{Binding TypeText}"
                                               TextColor="{DynamicResource KineticVolt}"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Chevron -->
                            <Label Grid.Column="1"
                                   Text="›"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
