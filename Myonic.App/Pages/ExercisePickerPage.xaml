<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Myonic.Core.Models;assembly=Myonic.Core"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.ExercisePickerPage"
             x:DataType="vm:ExercisePickerViewModel"
             x:Name="ThisPage"
             Title="Выбор упражнения"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <!-- Header with close button -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <Label Text="Выберите упражнение"
                   TextColor="{DynamicResource KineticText}"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Закрыть"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryActionButton}"
                    HeightRequest="38"
                    Padding="14,0"
                    FontSize="13" />
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource KineticWell}"
                Stroke="{DynamicResource KineticBorderSubtle}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="6,2">
            <SearchBar Placeholder="Поиск по названию..."
                       PlaceholderColor="{DynamicResource KineticTextMuted}"
                       TextColor="{DynamicResource KineticText}"
                       BackgroundColor="Transparent"
                       Text="{Binding SearchText}" />
        </Border>

        <!-- Exercises List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredExercises}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Упражнения не найдены"
                           TextColor="{DynamicResource KineticTextMuted}"
                           FontSize="15"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <Border BackgroundColor="{DynamicResource KineticWell}"
                            Stroke="{DynamicResource KineticBorderSubtle}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,12"
                            Margin="0,3">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectExerciseCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="›"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
