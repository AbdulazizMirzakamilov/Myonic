<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:repo="clr-namespace:Myonic.Core.Repositories;assembly=Myonic.Core"
             x:Class="Myonic.Pages.PersonalRecordsPage"
             x:DataType="vm:PersonalRecordsViewModel"
             x:Name="ThisPage"
             Title="Личные рекорды"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Добавить" Command="{Binding AddManualRecordCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,40" Spacing="16">

            <!-- Banner Card -->
            <Border BackgroundColor="{StaticResource KineticSurface}"
                    Stroke="{StaticResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ЛИЧНЫЕ ДОСТИЖЕНИЯ"
                               TextColor="{StaticResource KineticVolt}"
                               FontSize="11"
                               FontAttributes="Bold" />
                        <Label Text="Рекорды обновляются автоматически на тренировках или вносятся вручную."
                               TextColor="{StaticResource KineticTextSecondary}"
                               FontSize="13" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="+ Вручную"
                            Command="{Binding AddManualRecordCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="40"
                            Padding="12,0"
                            FontSize="12" />
                </Grid>
            </Border>

            <!-- Empty View -->
            <Border IsVisible="{Binding HasNoRecords}"
                    BackgroundColor="{StaticResource KineticSurface}"
                    Stroke="{StaticResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="24,32">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="🏆"
                           FontSize="40"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Рекордов пока нет"
                           TextColor="{StaticResource KineticText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Добавьте существующие рекорды вручную или проведите тренировку, чтобы приложение зафиксировало ваши максимальные веса."
                           TextColor="{StaticResource KineticTextSecondary}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                    <Button Text="+ Добавить первый рекорд"
                            Command="{Binding AddManualRecordCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="44"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Records Grouped by Exercise (BindableLayout on VerticalStackLayout) -->
            <VerticalStackLayout IsVisible="{Binding HasRecords}"
                                 BindableLayout.ItemsSource="{Binding GroupedRecords}"
                                 Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseGroupedRecords">
                        <Border BackgroundColor="{StaticResource KineticSurface}"
                                Stroke="{StaticResource KineticBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">

                                <!-- Exercise Header -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="{Binding ExerciseName}"
                                           TextColor="{StaticResource KineticText}"
                                           FontSize="17"
                                           FontAttributes="Bold" />
                                    <Button Grid.Column="1"
                                            Text="История →"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenExerciseDetailCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource SecondaryActionButton}"
                                            HeightRequest="32"
                                            Padding="10,0"
                                            FontSize="11" />
                                </Grid>

                                <!-- Records List for this Exercise -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Records}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="repo:PersonalRecordItem">
                                            <Border BackgroundColor="{StaticResource KineticWell}"
                                                    Stroke="{StaticResource KineticBorderSubtle}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Type Badge -->
                                                    <Border BackgroundColor="{StaticResource KineticSurface}"
                                                            Stroke="{StaticResource KineticBorderSubtle}"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="8,3"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding TypeDisplayName}"
                                                               TextColor="{StaticResource KineticVolt}"
                                                               FontSize="11"
                                                               FontAttributes="Bold" />
                                                    </Border>

                                                    <!-- Weight & Reps -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="{Binding Weight, StringFormat='{0} кг'}"
                                                                   TextColor="{StaticResource KineticText}"
                                                                   FontSize="16"
                                                                   FontAttributes="Bold" />
                                                            <Label Text="{Binding Reps, StringFormat='× {0}'}"
                                                                   TextColor="{StaticResource KineticTextSecondary}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding AchievedAt, StringFormat='{0:dd.MM.yyyy}'}"
                                                               TextColor="{StaticResource KineticTextMuted}"
                                                               FontSize="11" />
                                                    </VerticalStackLayout>

                                                    <!-- Source Indicator -->
                                                    <Label Grid.Column="2"
                                                           Text="{Binding SourceText}"
                                                           TextColor="{StaticResource KineticTextMuted}"
                                                           FontSize="10"
                                                           VerticalOptions="Center" />

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="3"
                                                            Text="✕"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteRecordCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource KineticTextMuted}"
                                                            FontSize="13"
                                                            WidthRequest="32"
                                                            HeightRequest="32"
                                                            Padding="0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
