<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:conv="clr-namespace:Myonic.Converters"
             x:Class="Myonic.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Профиль"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,40" Spacing="16">

            <!-- Active Workout Banner (Sticky Top) -->
            <Border IsVisible="{Binding ActiveWorkoutTracker.HasActiveSession}"
                    Stroke="{DynamicResource KineticVolt}"
                    StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding ActiveWorkoutTracker.Title}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="6,2">
                                <Label Text="{Binding ActiveWorkoutTracker.DurationText}"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                            <Label Text="Идёт тренировка"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Продолжить"
                            Command="{Binding ActiveWorkoutTracker.ResumeCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="38"
                            Padding="14,0"
                            FontSize="13"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Athlete Profile Header Card -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <!-- Avatar Badge -->
                    <Border BackgroundColor="{DynamicResource KineticWell}"
                            Stroke="{DynamicResource KineticVolt}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52"
                            HeightRequest="52"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="M"
                               TextColor="{DynamicResource KineticVolt}"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Атлет Myonic"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="19"
                               FontAttributes="Bold" />
                        <Label Text="Силовые тренировки • RPE трекинг"
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Overall Stats 3-Column Card -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <!-- Completed Workouts -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWorkoutHistoryCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding CompletedWorkoutsCount}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="ТРЕНИРОВОК"
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- PR Records -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="3">
                        <Label Text="{Binding PersonalRecordsCount}"
                               TextColor="{DynamicResource KineticVolt}"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="РЕКОРДОВ"
                               TextColor="{DynamicResource KineticVolt}"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Programs -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="3">
                        <Label Text="{Binding ProgramsCount}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="ПРОГРАММ"
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="10"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Weight Quick Card -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                        <Label Text="ТЕКУЩИЙ ВЕС"
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="10"
                               FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding LatestWeightText}"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="22"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="6,2"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding WeightDeltaText, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{Binding WeightDeltaText}"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="11"
                                       FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding WeightDateText}"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="11"
                               IsVisible="{Binding HasWeightData}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="+ Внести вес"
                            Command="{Binding QuickAddWeightCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="38"
                            Padding="14,0"
                            FontSize="12"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Goals Quick Card -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenGoalsCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🎯" FontSize="14" VerticalOptions="Center" />
                            <Label Text="ЦЕЛИ И НОРМАТИВЫ"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="+ Цель"
                                Command="{Binding QuickAddGoalCommand}"
                                Style="{StaticResource VoltButton}"
                                HeightRequest="32"
                                Padding="10,0"
                                FontSize="11"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- When user has a top active goal -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasTopGoal}">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="{Binding TopGoalTitle}"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding TopGoalProgressText}"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding TopGoalFraction}"
                                     ProgressColor="{DynamicResource KineticVolt}"
                                     BackgroundColor="{DynamicResource KineticWell}"
                                     HeightRequest="6" />
                    </VerticalStackLayout>

                    <!-- When user has no active goals -->
                    <Label Text="Поставьте силовую цель, целевой вес или норматив тренировок"
                           TextColor="{DynamicResource KineticTextSecondary}"
                           FontSize="12"
                           IsVisible="{Binding HasNoTopGoal}" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick Access Sections Header -->
            <Label Text="РАЗДЕЛЫ И БАЗА"
                   TextColor="{DynamicResource KineticTextMuted}"
                   FontSize="12"
                   FontAttributes="Bold"
                   Margin="4,6,0,0" />

            <!-- Workout History & Analytics Menu Item -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticVolt}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenWorkoutHistoryCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="📊" FontSize="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="История и Аналитика тренировок"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Графики объёма, частота, тоннаж и список сессий"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticVolt}" FontSize="22" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Goals Menu Item -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenGoalsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="🎯" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Цели и нормативы"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Силовые рубежи, целевой вес тела и замеры"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Exercise Library Menu Item -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenExercisesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="🏋️‍♂️" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="База упражнений"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Категории, история подходов и техника"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Personal Records Hall of Fame -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPersonalRecordsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="🏆" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Зал славы и рекорды (PR)"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="1RM, 5RM, максимальный рабочий вес"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Body Measurements Menu Item -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenBodyMeasurementsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="📏" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Антропометрия и замеры"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Динамика веса, объёмы тела и процент жира"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Settings Header -->
            <Label Text="НАСТРОЙКИ"
                   TextColor="{DynamicResource KineticTextMuted}"
                   FontSize="12"
                   FontAttributes="Bold"
                   Margin="4,6,0,0" />

            <!-- App Settings Menu Item -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Настройки приложения"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Тема оформления, светлый фон, тактильный отклик"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- About Myonic App -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Text="ℹ️" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="О приложении Myonic"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="Версия 1.0 • .NET 10 MAUI"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="{DynamicResource KineticTextMuted}" FontSize="20" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
