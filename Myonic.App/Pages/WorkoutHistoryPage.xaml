<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.WorkoutHistoryPage"
             x:Name="HistoryPage"
             x:DataType="vm:WorkoutHistoryViewModel"
             Title="История тренировок"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
        <!-- Active Workout Banner -->
        <Border IsVisible="{Binding ActiveWorkoutTracker.HasActiveSession}"
                Stroke="{DynamicResource KineticVolt}"
                StrokeThickness="1.5"
                BackgroundColor="{DynamicResource KineticSurface}"
                StrokeShape="RoundRectangle 12"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="ИДЕТ АКТИВНАЯ ТРЕНИРОВКА"
                               TextColor="{DynamicResource KineticVolt}"
                               FontSize="11"
                               FontAttributes="Bold" />
                        <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" />
                        <Label Text="{Binding ActiveWorkoutTracker.DurationText}"
                               TextColor="{DynamicResource KineticVolt}"
                               FontSize="11"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ActiveWorkoutTracker.Title}"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Продолжить"
                        Command="{Binding ActiveWorkoutTracker.ResumeCommand}"
                        Style="{StaticResource VoltButton}"
                        HeightRequest="42"
                        Padding="16,0"
                        FontSize="13" />
            </Grid>
        </Border>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasNoHistory}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="История пока пуста"
                   TextColor="{DynamicResource KineticText}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
            <Label Text="Завершённые тренировки будут отображаться здесь."
                   TextColor="{DynamicResource KineticTextMuted}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Sessions list -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding PastSessions}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PastWorkoutItem">
                    <Border BackgroundColor="{DynamicResource KineticSurface}"
                            Stroke="{DynamicResource KineticBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference HistoryPage}, Path=BindingContext.OpenSessionDetailCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}"
                                       TextColor="{DynamicResource KineticText}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Grid.Column="1"
                                       Text="{Binding DurationText}"
                                       TextColor="{DynamicResource KineticEmerald}"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <Label Text="{Binding DateText}"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Label Text="{Binding SummaryText}"
                                       TextColor="{DynamicResource KineticTextSecondary}"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="Разбор →"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
