<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.WorkoutHistoryPage"
             x:DataType="vm:WorkoutHistoryViewModel"
             Title="История тренировок">

    <Grid Padding="16">
        <!-- Empty state -->
        <VerticalStackLayout IsVisible="{Binding HasNoHistory}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="История пока пуста"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
            <Label Text="Завершённые тренировки будут отображаться здесь."
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Sessions list -->
        <CollectionView ItemsSource="{Binding PastSessions}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PastWorkoutItem">
                    <Grid Padding="12,14" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Title}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="16" />
                            <Label Grid.Column="1"
                                   Text="{Binding DurationText}"
                                   FontSize="13" />
                        </Grid>

                        <Label Grid.Row="1"
                               Text="{Binding DateText}"
                               FontSize="12" />

                        <Label Grid.Row="2"
                               Text="{Binding SummaryText}"
                               FontSize="13"
                               FontFamily="OpenSansSemibold" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
