<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.WorkoutHistoryPage"
             x:Name="HistoryPage"
             x:DataType="vm:WorkoutHistoryViewModel"
             Title="История тренировок"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
                    <!-- Active Workout Banner (Sticky Top) -->
            <Border IsVisible="{Binding ActiveWorkoutTracker.HasActiveSession}"
                    Stroke="{DynamicResource KineticVolt}"
                    StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding ActiveWorkoutTracker.Title}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="6,2">
                                <Label Text="{Binding ActiveWorkoutTracker.DurationText}"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                            <Label Text="Идёт тренировка"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Продолжить"
                            Command="{Binding ActiveWorkoutTracker.ResumeCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="38"
                            Padding="14,0"
                            FontSize="13"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasNoHistory}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="История пока пуста"
                   TextColor="{DynamicResource KineticText}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
            <Label Text="Завершённые тренировки будут отображаться здесь."
                   TextColor="{DynamicResource KineticTextMuted}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Sessions list -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding PastSessions}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PastWorkoutItem">
                    <Border BackgroundColor="{DynamicResource KineticSurface}"
                            Stroke="{DynamicResource KineticBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference HistoryPage}, Path=BindingContext.OpenSessionDetailCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}"
                                       TextColor="{DynamicResource KineticText}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Grid.Column="1"
                                       Text="{Binding DurationText}"
                                       TextColor="{DynamicResource KineticEmerald}"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <Label Text="{Binding DateText}"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Label Text="{Binding SummaryText}"
                                       TextColor="{DynamicResource KineticTextSecondary}"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="Разбор →"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
