<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:repo="clr-namespace:Myonic.Core.Repositories;assembly=Myonic.Core"
             xmlns:conv="clr-namespace:Myonic.Converters"
             x:Class="Myonic.Pages.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             x:Name="ThisPage"
             Title="Расписание"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:DayStrokeConverter x:Key="DayStrokeConverter" />
            <conv:DayStrokeColorConverter x:Key="DayStrokeColorConverter" />
            <conv:DayBgColorConverter x:Key="DayBgColorConverter" />
            <conv:DayTextColorConverter x:Key="DayTextColorConverter" />
            <conv:DayTextMutedColorConverter x:Key="DayTextMutedColorConverter" />
            <conv:DayCompletedIconColorConverter x:Key="DayCompletedIconColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,40', Desktop='28,20,28,40'}"
                             Spacing="16"
                             HorizontalOptions="Fill">

                <!-- Active Workout Banner (Sticky Top) -->
                <Border IsVisible="{Binding HasActiveSession}"
                        Stroke="{DynamicResource KineticVolt}"
                        StrokeThickness="1.5"
                        BackgroundColor="{DynamicResource KineticSurface}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="ИДЕТ АКТИВНАЯ ТРЕНИРОВКА"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ActiveSession.Title}"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Продолжить"
                                Command="{Binding ResumeActiveSessionCommand}"
                                Style="{StaticResource VoltButton}"
                                HeightRequest="42"
                                Padding="16,0"
                                FontSize="13" />
                    </Grid>
                </Border>

                <!-- Calendar Header: Month/Year, Week Number & Navigation -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding WeekNumberHeader}"
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="11"
                               FontAttributes="Bold" />
                        <Label Text="{Binding MonthYearHeader}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="22"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Navigation Buttons: Previous, Today, Next -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="‹"
                                Command="{Binding PreviousWeekCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="18"
                                FontAttributes="Bold" />
                        <Button Text="Сегодня"
                                Command="{Binding TodayCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                HeightRequest="40"
                                Padding="14,0"
                                FontSize="13"
                                FontAttributes="Bold" />
                        <Button Text="›"
                                Command="{Binding NextWeekCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                FontSize="18"
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Weekly Calendar Strip (7 Columns Grid) -->
                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="6,8">
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6">

                        <!-- Day 0 (ПН) -->
                        <Border Grid.Column="0"
                                BindingContext="{Binding Day0}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 1 (ВТ) -->
                        <Border Grid.Column="1"
                                BindingContext="{Binding Day1}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 2 (СР) -->
                        <Border Grid.Column="2"
                                BindingContext="{Binding Day2}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 3 (ЧТ) -->
                        <Border Grid.Column="3"
                                BindingContext="{Binding Day3}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 4 (ПТ) -->
                        <Border Grid.Column="4"
                                BindingContext="{Binding Day4}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 5 (СБ) -->
                        <Border Grid.Column="5"
                                BindingContext="{Binding Day5}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 6 (ВС) -->
                        <Border Grid.Column="6"
                                BindingContext="{Binding Day6}"
                                x:DataType="vm:CalendarDayItem"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}, FallbackValue=1}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}, FallbackValue='#2A313E'}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}, FallbackValue='#1F242D'}"
                                StrokeShape="RoundRectangle 10"
                                Padding="2,8"
                                HeightRequest="{OnIdiom Phone=80, Desktop=86}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding DayName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}, FallbackValue='#94A3B8'}" />
                                <Label Text="{Binding DayNumber}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}, FallbackValue='#FFFFFF'}" />
                                <Grid HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✔"
                                           IsVisible="{Binding HasCompletedWorkout}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource DayCompletedIconColorConverter}, FallbackValue='#10B981'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Ellipse WidthRequest="6"
                                             HeightRequest="6"
                                             Fill="{DynamicResource KineticIceBlue}"
                                             IsVisible="{Binding ShowPlannedIndicator}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </Border>

                <!-- Selected Date Headline & Actions -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="{Binding SelectedDateFormatted}"
                           TextColor="{DynamicResource KineticTextSecondary}"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <!-- Quick Start Buttons -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Button Text="+ Свободная"
                                Command="{Binding StartFreeWorkoutCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                HeightRequest="38"
                                Padding="12,0"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button Text="Из программы..."
                                Command="{Binding ChooseProgramWorkoutCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                HeightRequest="38"
                                Padding="12,0"
                                FontSize="12"
                                FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- CASE 1: Completed Workouts on Selected Date -->
                <VerticalStackLayout IsVisible="{Binding HasCompletedWorkouts}" Spacing="12">
                    <Label Text="ВЫПОЛНЕННЫЕ ТРЕНИРОВКИ"
                           TextColor="{DynamicResource KineticEmerald}"
                           FontSize="11"
                           FontAttributes="Bold"
                           Margin="2,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedSessions}" Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayCompletedSessionItem">
                                <Border BackgroundColor="{DynamicResource KineticSurface}"
                                        Stroke="{DynamicResource KineticBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="{OnIdiom Phone=16, Desktop=20}">
                                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='360,*'}" ColumnSpacing="20" RowSpacing="14">
                                        <!-- Left Side: Summary & Action -->
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Title}"
                                                           TextColor="{DynamicResource KineticText}"
                                                           FontSize="19"
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding TimeText}"
                                                           TextColor="{DynamicResource KineticTextMuted}"
                                                           FontSize="13" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        BackgroundColor="{DynamicResource KineticWell}"
                                                        Stroke="{DynamicResource KineticBorderSubtle}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="10,4"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding DurationText}"
                                                           TextColor="{DynamicResource KineticEmerald}"
                                                           FontSize="12"
                                                           FontAttributes="Bold" />
                                                </Border>
                                            </Grid>

                                            <Label Text="{Binding SetsCount, StringFormat='Выполнено подходов: {0}'}"
                                                   TextColor="{DynamicResource KineticTextSecondary}"
                                                   FontSize="13" />

                                            <Button Text="Разбор тренировки (План / Факт) →"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenSessionDetailCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SecondaryActionButton}"
                                                    HeightRequest="40"
                                                    FontSize="12"
                                                    FontAttributes="Bold" />
                                        </VerticalStackLayout>

                                        <!-- Right Side: Executed Sets Breakdown -->
                                        <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                                             Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                             Spacing="8">
                                            <Label Text="Выполненные упражнения:"
                                                   TextColor="{DynamicResource KineticTextMuted}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />

                                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12,10">
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="10">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DayCompletedExerciseItem">
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Text="{Binding ExerciseName}"
                                                                       TextColor="{DynamicResource KineticVolt}"
                                                                       FontSize="14"
                                                                       FontAttributes="Bold" />

                                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SetsSummary}" Spacing="2">
                                                                    <BindableLayout.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <Label Text="{Binding .}"
                                                                                   TextColor="{DynamicResource KineticTextSecondary}"
                                                                                   FontSize="12"
                                                                                   Margin="8,1,0,1" />
                                                                        </DataTemplate>
                                                                    </BindableLayout.ItemTemplate>
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- CASE 2: Planned Workout Hero Card (from active program/schedule) -->
                <VerticalStackLayout IsVisible="{Binding HasPlannedWorkouts}" Spacing="12">
                    <Label Text="ЗАПЛАНИРОВАННАЯ ТРЕНИРОВКА"
                           TextColor="{DynamicResource KineticIceBlue}"
                           FontSize="11"
                           FontAttributes="Bold"
                           Margin="2,0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlannedWorkouts}" Spacing="14">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="repo:PlannedWorkoutSummary">
                                <Border BackgroundColor="{DynamicResource KineticSurface}"
                                        Stroke="{DynamicResource KineticBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="{OnIdiom Phone=16, Desktop=22}">
                                    <Grid ColumnDefinitions="{OnIdiom Phone='*', Desktop='340,*'}" ColumnSpacing="24" RowSpacing="14">
                                        <!-- Left Side: Workout Title, Program Badge, Start Action -->
                                        <VerticalStackLayout Spacing="14">
                                            <VerticalStackLayout Spacing="4">
                                                <Border BackgroundColor="{DynamicResource KineticWell}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,3"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding ProgramName}"
                                                           TextColor="{DynamicResource KineticIceBlue}"
                                                           FontSize="11"
                                                           FontAttributes="Bold" />
                                                </Border>

                                                <Label Text="{Binding WorkoutName}"
                                                       TextColor="{DynamicResource KineticText}"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       Margin="0,4,0,0" />

                                                <Label Text="{Binding ExerciseCount, StringFormat='Упражнений: {0}'}"
                                                       TextColor="{DynamicResource KineticTextMuted}"
                                                       FontSize="13" />
                                            </VerticalStackLayout>

                                            <!-- Large Start Button -->
                                            <Button Text="НАЧАТЬ ТРЕНИРОВКУ"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartPlannedWorkoutCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource VoltButton}"
                                                    HeightRequest="50"
                                                    FontSize="14" />
                                        </VerticalStackLayout>

                                        <!-- Right Side: Planned Exercise List -->
                                        <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                                             Grid.Row="{OnIdiom Phone=1, Desktop=0}"
                                                             Spacing="8">
                                            <Label Text="План упражнений на сегодня:"
                                                   TextColor="{DynamicResource KineticTextMuted}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />

                                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="14,10">
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="8">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="repo:PlannedExerciseItem">
                                                            <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                                                <Label Text="{Binding ExerciseName}"
                                                                       TextColor="{DynamicResource KineticText}"
                                                                       FontSize="14"
                                                                       FontAttributes="Bold"
                                                                       LineBreakMode="TailTruncation" />
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding PlanText}"
                                                                       TextColor="{DynamicResource KineticVolt}"
                                                                       FontSize="13"
                                                                       FontAttributes="Bold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- CASE 3: Rest Day / No planned workouts -->
                <Border IsVisible="{Binding IsRestDay}"
                        BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="{OnIdiom Phone=20, Desktop=28}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" MaximumWidthRequest="500">
                        <Label Text="Отдых или свободная тренировка"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="На этот день нет запланированных тренировок. Вы можете восстановиться или провести свободную тренировку."
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />

                        <Button Text="+ Начать свободную тренировку"
                                Command="{Binding StartFreeWorkoutCommand}"
                                Style="{StaticResource VoltButton}"
                                HeightRequest="46"
                                FontSize="14"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
    </ScrollView>
</ContentPage>
