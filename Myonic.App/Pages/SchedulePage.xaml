<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:calendar="clr-namespace:Myonic.Core.Calendar;assembly=Myonic.Core"
             xmlns:repo="clr-namespace:Myonic.Core.Repositories;assembly=Myonic.Core"
             xmlns:conv="clr-namespace:Myonic.Converters"
             x:Class="Myonic.Pages.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             x:Name="ThisPage"
             Title="Расписание"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:DayStrokeConverter x:Key="DayStrokeConverter" />
            <conv:DayStrokeColorConverter x:Key="DayStrokeColorConverter" />
            <conv:DayBgColorConverter x:Key="DayBgColorConverter" />
            <conv:SwitcherBgColorConverter x:Key="SwitcherBgColorConverter" />
            <conv:SwitcherTextColorConverter x:Key="SwitcherTextColorConverter" />
            <conv:DayTextColorConverter x:Key="DayTextColorConverter" />
            <conv:DayTextMutedColorConverter x:Key="DayTextMutedColorConverter" />
            <conv:DayCompletedIconColorConverter x:Key="DayCompletedIconColorConverter" />
            <conv:MonthDayOpacityConverter x:Key="MonthDayOpacityConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,12,16,40', Desktop='28,20,28,40'}"
                             Spacing="16"
                             HorizontalOptions="Fill">

                        <!-- Active Workout Banner (Sticky Top) -->
            <Border IsVisible="{Binding ActiveWorkoutTracker.HasActiveSession}"
                    Stroke="{DynamicResource KineticVolt}"
                    StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding ActiveWorkoutTracker.Title}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorderSubtle}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="6,2">
                                <Label Text="{Binding ActiveWorkoutTracker.DurationText}"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                            <Label Text="Идёт тренировка"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Продолжить"
                            Command="{Binding ActiveWorkoutTracker.ResumeCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="38"
                            Padding="14,0"
                            FontSize="13"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Calendar Header: Month/Year, Navigation & View Switcher (Week / Month) -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding WeekNumberHeader}"
                           TextColor="{DynamicResource KineticTextMuted}"
                           FontSize="11"
                           FontAttributes="Bold" />
                    <Label Text="{Binding MonthYearHeader}"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="22"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Navigation Buttons: Previous, Today, Next -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="‹"
                            Command="{Binding PreviousPeriodCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="0"
                            FontSize="18"
                            FontAttributes="Bold" />
                    <Button Text="Сегодня"
                            Command="{Binding TodayCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            HeightRequest="38"
                            Padding="12,0"
                            FontSize="12"
                            FontAttributes="Bold" />
                    <Button Text="›"
                            Command="{Binding NextPeriodCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="0"
                            FontSize="18"
                            FontAttributes="Bold" />
                </HorizontalStackLayout>

                <!-- Mode Switcher: Неделя / Месяц -->
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        BackgroundColor="{DynamicResource KineticWell}"
                        Stroke="{DynamicResource KineticBorderSubtle}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="3"
                        HorizontalOptions="Start">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                        <!-- Week View Button -->
                        <Border BackgroundColor="{Binding IsWeekView, Converter={StaticResource SwitcherBgColorConverter}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToWeekViewCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Неделя"
                                   TextColor="{Binding IsWeekView, Converter={StaticResource SwitcherTextColorConverter}}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Border>

                        <!-- Month View Button -->
                        <Border Grid.Column="1"
                                BackgroundColor="{Binding IsMonthView, Converter={StaticResource SwitcherBgColorConverter}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToMonthViewCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Месяц"
                                   TextColor="{Binding IsMonthView, Converter={StaticResource SwitcherTextColorConverter}}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Calendar Card: Direct Tap Navigation -->
            <Border x:Name="CalendarOuterCard"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="10,12">
                <Grid IsClippedToBounds="True">
                    <Grid x:Name="CalendarViewHost">

                    <!-- 1. WEEK VIEW STRIP (7 Days) -->
                    <Grid x:Name="WeekViewContainer"
                          IsVisible="{Binding IsWeekView}"
                          ColumnDefinitions="*,*,*,*,*,*,*"
                          ColumnSpacing="6"
                          HeightRequest="68">

                        <!-- Day 0: Monday -->
                        <Border Grid.Column="0"
                                BindingContext="{Binding Day0}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 1: Tuesday -->
                        <Border Grid.Column="1"
                                BindingContext="{Binding Day1}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 2: Wednesday -->
                        <Border Grid.Column="2"
                                BindingContext="{Binding Day2}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 3: Thursday -->
                        <Border Grid.Column="3"
                                BindingContext="{Binding Day3}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 4: Friday -->
                        <Border Grid.Column="4"
                                BindingContext="{Binding Day4}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 5: Saturday -->
                        <Border Grid.Column="5"
                                BindingContext="{Binding Day5}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Day 6: Sunday -->
                        <Border Grid.Column="6"
                                BindingContext="{Binding Day6}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDayTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- 2. MONTH VIEW GRID (7 Columns) -->
                    <VerticalStackLayout x:Name="MonthViewContainer"
                                         IsVisible="{Binding IsMonthView}"
                                         Spacing="6">

                        <!-- Days of Week Header Labels -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4" Padding="0,2,0,4">
                            <Label Text="ПН" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="ВТ" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="СР" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="ЧТ" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="ПТ" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="СБ" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="ВС" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </Grid>

                        <!-- Month Grid Weeks -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MonthWeeks}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarWeekRowItem">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4" HeightRequest="52">

                                        <!-- Day 0: Monday -->
                                        <Border Grid.Column="0"
                                                BindingContext="{Binding Day0}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 1: Tuesday -->
                                        <Border Grid.Column="1"
                                                BindingContext="{Binding Day1}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 2: Wednesday -->
                                        <Border Grid.Column="2"
                                                BindingContext="{Binding Day2}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 3: Thursday -->
                                        <Border Grid.Column="3"
                                                BindingContext="{Binding Day3}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 4: Friday -->
                                        <Border Grid.Column="4"
                                                BindingContext="{Binding Day4}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 5: Saturday -->
                                        <Border Grid.Column="5"
                                                BindingContext="{Binding Day5}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Day 6: Sunday -->
                                        <Border Grid.Column="6"
                                                BindingContext="{Binding Day6}"
                                                Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                                StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                    <Ellipse WidthRequest="4" HeightRequest="4" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

            <!-- Selected Date Headline -->
            <Label Text="{Binding SelectedDateFormatted}"
                   TextColor="{DynamicResource KineticTextSecondary}"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="4,4,0,0" />

            <!-- Workout Cards of the Selected Day -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Workouts}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="calendar:CalendarWorkoutItem">
                        <Border BackgroundColor="{DynamicResource KineticSurface}"
                                Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">

                                <!-- Card Header: Title & Status Badge -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               TextColor="{DynamicResource KineticText}"
                                               FontSize="18"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ProgramName}"
                                               TextColor="{DynamicResource KineticTextMuted}"
                                               FontSize="12"
                                               IsVisible="{Binding HasProgramName}" />
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,4"
                                            VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource KineticEmerald}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPlanned}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource KineticWell}" />
                                                <Setter Property="Stroke" Value="{DynamicResource KineticIceBlue}" />
                                                <Setter Property="StrokeThickness" Value="1" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding StatusIcon}"
                                                   FontSize="11"
                                                   FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextColor" Value="#0F172A" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPlanned}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource KineticIceBlue}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding StatusDisplayName}"
                                                   FontSize="11"
                                                   FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextColor" Value="#0F172A" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsPlanned}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource KineticIceBlue}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Time & Duration Info (for Completed sessions) -->
                                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCompleted}" VerticalOptions="Center">
                                    <Label Text="{Binding TimeText}" TextColor="{DynamicResource KineticTextSecondary}" FontSize="12" />
                                    <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" IsVisible="{Binding HasDurationText}" />
                                    <Label Text="{Binding DurationText}" TextColor="{DynamicResource KineticTextSecondary}" FontSize="12" IsVisible="{Binding HasDurationText}" />
                                    <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" />
                                    <Label Text="{Binding SummaryText}" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" />
                                </HorizontalStackLayout>

                                <!-- Planned summary info (for Planned workouts) -->
                                <Label Text="{Binding SummaryText}"
                                       TextColor="{DynamicResource KineticTextMuted}"
                                       FontSize="12"
                                       IsVisible="{Binding IsPlanned}" />

                                <BoxView HeightRequest="1" Color="{DynamicResource KineticBorderSubtle}" />

                                <!-- Completed Exercises and Actual Sets Preview -->
                                <VerticalStackLayout IsVisible="{Binding HasCompletedExercises}" Spacing="6">
                                    <Label Text="ВЫПОЛНЕННЫЕ ПОДХОДЫ:"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedExercises}" Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="calendar:CalendarCompletedExerciseItem">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,2">
                                                    <Label Text="•" TextColor="{DynamicResource KineticEmerald}" FontSize="14" VerticalOptions="Start" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                        <Label Text="{Binding ExerciseName}" TextColor="{DynamicResource KineticText}" FontSize="13" FontAttributes="Bold" />
                                                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SetsSummary}" Spacing="6">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <Border BackgroundColor="{DynamicResource KineticWell}"
                                                                            StrokeShape="RoundRectangle 6"
                                                                            Padding="6,2">
                                                                        <Label Text="{Binding .}" TextColor="{DynamicResource KineticTextSecondary}" FontSize="11" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Planned Exercises List Preview -->
                                <VerticalStackLayout IsVisible="{Binding HasPlannedExercises}" Spacing="6">
                                    <Label Text="ПЛАН УПРАЖНЕНИЙ:"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlannedExercises}" Spacing="3">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="repo:PlannedExerciseItem">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,2">
                                                    <Label Text="•" TextColor="{DynamicResource KineticIceBlue}" FontSize="14" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding ExerciseName}" TextColor="{DynamicResource KineticText}" FontSize="13" VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="{Binding TargetSummary}" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Action Button: Details for Completed, Start for Planned -->
                                <Button Text="Подробнее о тренировке"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWorkoutDetailCommand}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnWorkoutDetailClicked"
                                        IsVisible="{Binding CanViewDetails}"
                                        Style="{StaticResource SecondaryActionButton}"
                                        HeightRequest="42"
                                        FontSize="13" />

                                <Button Text="Начать тренировку"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartPlannedWorkoutCommand}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnStartWorkoutClicked"
                                        IsVisible="{Binding CanStart}"
                                        Style="{StaticResource VoltButton}"
                                        HeightRequest="44"
                                        FontSize="14" />

                                <Border BackgroundColor="{DynamicResource KineticWell}"
                                        Stroke="{DynamicResource KineticBorderSubtle}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,8"
                                        IsVisible="{Binding IsFuture}">
                                    <Label Text="📅 Тренировка будет доступна в назначенный день"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Rest Day / Empty State -->
            <Border IsVisible="{Binding IsRestDay}"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20,24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="🛌" FontSize="32" HorizontalTextAlignment="Center" />
                    <Label Text="В этот день тренировок нет"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Отличный день для отдыха и восстановления мышц."
                           TextColor="{DynamicResource KineticTextMuted}"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
