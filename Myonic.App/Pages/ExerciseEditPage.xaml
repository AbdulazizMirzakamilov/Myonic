<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Myonic.Pages.ExerciseEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Myonic.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:ExerciseEditViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Label Text="Название" />
            <Entry Placeholder="Например, Жим лёжа" Text="{Binding Name}" />

            <Label Margin="0,8,0,0" Text="Тип" />
            <Picker ItemsSource="{Binding TypeOptions}" SelectedIndex="{Binding TypeIndex}" />

            <Label Margin="0,8,0,0" Text="Описание" />
            <Editor HeightRequest="100" Text="{Binding Description}" />

            <Label Margin="0,8,0,0" Text="Заметки" />
            <Editor HeightRequest="100" Text="{Binding Notes}" />

            <Button
                Margin="0,16,0,0"
                Command="{Binding SaveCommand}"
                Text="Сохранить" />
            <Button
                BackgroundColor="Firebrick"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding CanDelete}"
                Text="Удалить" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>