<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.ProgramExerciseEditPage"
             x:DataType="vm:ProgramExerciseEditViewModel"
             Title="Параметры упражнения">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding ExerciseName}" FontAttributes="Bold" FontSize="20" />

            <Label Text="Подходы" Margin="0,4,0,0" />
            <Entry Text="{Binding SetsText}" Keyboard="Numeric" Placeholder="Например, 4" />

            <Label Text="Повторения (от — до)" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,Auto,*">
                <Entry Grid.Column="0" Text="{Binding RepsText}" Keyboard="Numeric" Placeholder="От (напр. 8)" />
                <Label Grid.Column="1" Text="—" VerticalOptions="Center" HorizontalOptions="Center" Margin="8,0" />
                <Entry Grid.Column="2" Text="{Binding RepsMaxText}" Keyboard="Numeric" Placeholder="До (напр. 12)" />
            </Grid>

            <Label Text="Целевой вес, кг (необязательно)" Margin="0,4,0,0" />
            <Entry Text="{Binding WeightText}" Keyboard="Numeric" Placeholder="Можно оставить пустым" />

            <Label Text="RPE (5.5 – 10 с шагом 0.5, необязательно)" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,Auto,*">
                <Entry Grid.Column="0" Text="{Binding RpeText}" Keyboard="Numeric" Placeholder="От (напр. 8)" />
                <Label Grid.Column="1" Text="—" VerticalOptions="Center" HorizontalOptions="Center" Margin="8,0" />
                <Entry Grid.Column="2" Text="{Binding RpeMaxText}" Keyboard="Numeric" Placeholder="До (напр. 9)" />
            </Grid>

            <Label Text="Отдых, секунд (необязательно)" Margin="0,4,0,0" />
            <Entry Text="{Binding RestText}" Keyboard="Numeric" Placeholder="Например, 120" />

            <Label Text="Заметки" Margin="0,4,0,0" />
            <Editor Text="{Binding Notes}" HeightRequest="100" />

            <Button Text="Сохранить" Command="{Binding SaveCommand}" Margin="0,16,0,0" />
            <Button Text="Убрать из тренировки" Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsExisting}" BackgroundColor="Firebrick" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
