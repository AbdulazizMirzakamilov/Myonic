<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:calendar="clr-namespace:Myonic.Core.Calendar;assembly=Myonic.Core"
             xmlns:repo="clr-namespace:Myonic.Core.Repositories;assembly=Myonic.Core"
             xmlns:conv="clr-namespace:Myonic.Converters"
             x:Class="Myonic.Pages.CalendarFullPage"
             x:DataType="vm:ScheduleViewModel"
             x:Name="ThisPage"
             Title="Календарь"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:DayStrokeConverter x:Key="DayStrokeConverter" />
            <conv:DayStrokeColorConverter x:Key="DayStrokeColorConverter" />
            <conv:DayBgColorConverter x:Key="DayBgColorConverter" />
            <conv:DayTextColorConverter x:Key="DayTextColorConverter" />
            <conv:DayTextMutedColorConverter x:Key="DayTextMutedColorConverter" />
            <conv:DayCompletedIconColorConverter x:Key="DayCompletedIconColorConverter" />
            <conv:MonthDayOpacityConverter x:Key="MonthDayOpacityConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,14,16,40', Desktop='28,20,28,40'}"
                             Spacing="16"
                             HorizontalOptions="Fill">

            <!-- Active Workout Banner (Sticky Top) -->
            <Border IsVisible="{Binding ActiveWorkoutTracker.HasActiveSession}"
                    Stroke="{DynamicResource KineticVolt}"
                    StrokeThickness="1.5"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="ИДЕТ АКТИВНАЯ ТРЕНИРОВКА"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                            <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" />
                            <Label Text="{Binding ActiveWorkoutTracker.DurationText}"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ActiveWorkoutTracker.Title}"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="16"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Продолжить"
                            Command="{Binding ActiveWorkoutTracker.ResumeCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="42"
                            Padding="16,0"
                            FontSize="13" />
                </Grid>
            </Border>

            <!-- Header: Title, Mode Switcher (Month / Week) & Period Navigation -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding WeekNumberHeader}"
                           TextColor="{DynamicResource KineticTextMuted}"
                           FontSize="11"
                           FontAttributes="Bold" />
                    <Label Text="{Binding MonthYearHeader}"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="24"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Navigation Controls: < Today > -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="‹"
                            Command="{Binding PreviousPeriodCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="0"
                            FontSize="18"
                            FontAttributes="Bold" />
                    <Button Text="Сегодня"
                            Command="{Binding TodayCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            HeightRequest="38"
                            Padding="12,0"
                            FontSize="12"
                            FontAttributes="Bold" />
                    <Button Text="›"
                            Command="{Binding NextPeriodCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="0"
                            FontSize="18"
                            FontAttributes="Bold" />
                </HorizontalStackLayout>

                <!-- Mode Toggle (Month / Week) -->
                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        BackgroundColor="{DynamicResource KineticWell}"
                        Stroke="{DynamicResource KineticBorderSubtle}"
                        StrokeShape="RoundRectangle 10"
                        Padding="3"
                        HorizontalOptions="Start">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                        <!-- Month View Button -->
                        <Border BackgroundColor="{Binding IsMonthView, Converter={StaticResource DayBgColorConverter}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToMonthViewCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Месяц"
                                   TextColor="{Binding IsMonthView, Converter={StaticResource DayTextColorConverter}}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Border>

                        <!-- Week View Button -->
                        <Border Grid.Column="1"
                                BackgroundColor="{Binding IsWeekView, Converter={StaticResource DayBgColorConverter}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SwitchToWeekViewCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Неделя"
                                   TextColor="{Binding IsWeekView, Converter={StaticResource DayTextColorConverter}}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 1. MONTH VIEW (Full Calendar Grid with Swipe) -->
            <Border IsVisible="{Binding IsMonthView}"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="8,12">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnCalendarPanUpdated" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <!-- Day of week header row: ПН ВТ СР ЧТ ПТ СБ ВС -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" Margin="0,0,0,2">
                        <Label Grid.Column="0" Text="ПН" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="ВТ" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="СР" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="ЧТ" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="ПТ" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="СБ" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="ВС" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource KineticTextMuted}" HorizontalTextAlignment="Center" />
                    </Grid>

                    <!-- Month Weeks Rows -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MonthWeeks}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarWeekRowItem">
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" HeightRequest="52">

                                    <!-- Col 0: Day0 -->
                                    <Border Grid.Column="0"
                                            BindingContext="{Binding Day0}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 1: Day1 -->
                                    <Border Grid.Column="1"
                                            BindingContext="{Binding Day1}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 2: Day2 -->
                                    <Border Grid.Column="2"
                                            BindingContext="{Binding Day2}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 3: Day3 -->
                                    <Border Grid.Column="3"
                                            BindingContext="{Binding Day3}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 4: Day4 -->
                                    <Border Grid.Column="4"
                                            BindingContext="{Binding Day4}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 5: Day5 -->
                                    <Border Grid.Column="5"
                                            BindingContext="{Binding Day5}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Col 6: Day6 -->
                                    <Border Grid.Column="6"
                                            BindingContext="{Binding Day6}"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                                            StrokeShape="RoundRectangle 10"
                                            Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthDayOpacityConverter}}"
                                            Padding="2,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="*,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding DayNumber}"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center" />
                                            <HorizontalStackLayout Grid.Row="1" Spacing="2" HorizontalOptions="Center" Margin="0,1,0,0">
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 2. WEEK VIEW (Detailed 7 Days Strip with Swipe) -->
            <Border IsVisible="{Binding IsWeekView}"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="10,14">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnCalendarPanUpdated" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" HeightRequest="68">
                    <!-- Day 0..6 inside week strip -->
                    <Border Grid.Column="0"
                            BindingContext="{Binding Day0}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BindingContext="{Binding Day1}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            BindingContext="{Binding Day2}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3"
                            BindingContext="{Binding Day3}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="4"
                            BindingContext="{Binding Day4}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="5"
                            BindingContext="{Binding Day5}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="6"
                            BindingContext="{Binding Day6}"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource DayBgColorConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource DayStrokeColorConverter}}"
                            StrokeThickness="{Binding IsSelected, Converter={StaticResource DayStrokeConverter}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="2,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectDayCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextMutedColorConverter}}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}" TextColor="{Binding IsSelected, Converter={StaticResource DayTextColorConverter}}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticEmerald}" IsVisible="{Binding HasCompletedWorkout}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticIceBlue}" IsVisible="{Binding ShowPlannedIndicator}" />
                                <Ellipse WidthRequest="5" HeightRequest="5" Fill="{DynamicResource KineticCrimson}" IsVisible="{Binding ShowMissedIndicator}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Legend of Status Indicators -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" Margin="0,-4,0,4">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="7" HeightRequest="7" Fill="{DynamicResource KineticEmerald}" />
                    <Label Text="Выполнена" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="7" HeightRequest="7" Fill="{DynamicResource KineticIceBlue}" />
                    <Label Text="Запланирована" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="7" HeightRequest="7" Fill="{DynamicResource KineticCrimson}" />
                    <Label Text="Пропущена" TextColor="{DynamicResource KineticTextMuted}" FontSize="11" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- Selected Date Header -->
            <Label Text="{Binding SelectedDateFormatted}"
                   TextColor="{DynamicResource KineticText}"
                   FontSize="17"
                   FontAttributes="Bold"
                   Margin="4,6,0,0" />

            <!-- LIST OF WORKOUTS FOR SELECTED DATE -->
            <VerticalStackLayout IsVisible="{Binding HasWorkouts}"
                                 BindableLayout.ItemsSource="{Binding Workouts}"
                                 Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="calendar:CalendarWorkoutItem">
                        <Border BackgroundColor="{DynamicResource KineticSurface}"
                                Stroke="{DynamicResource KineticBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="16">
                            <VerticalStackLayout Spacing="10">
                                <!-- Top Row: Title, Program Name and Colored Status Badge -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               TextColor="{DynamicResource KineticText}"
                                               FontSize="16"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ProgramName}"
                                               IsVisible="{Binding ProgramName, Converter={StaticResource MonthDayOpacityConverter}}"
                                               TextColor="{DynamicResource KineticTextSecondary}"
                                               FontSize="12" />
                                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCompleted}">
                                            <Label Text="{Binding TimeText}" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" />
                                            <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" />
                                            <Label Text="{Binding DurationText}" TextColor="{DynamicResource KineticTextMuted}" FontSize="12" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1"
                                            BackgroundColor="{DynamicResource KineticWell}"
                                            Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,4"
                                            VerticalOptions="Start">
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding StatusIcon}"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding StatusDisplayName}"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Summary Text -->
                                <Label Text="{Binding SummaryText}"
                                       TextColor="{DynamicResource KineticTextSecondary}"
                                       FontSize="13" />

                                <!-- Completed Exercises Preview -->
                                <Border IsVisible="{Binding HasCompletedExercises}"
                                        BackgroundColor="{DynamicResource KineticWell}"
                                        Stroke="{DynamicResource KineticBorderSubtle}"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,10">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CompletedExercises}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="calendar:CalendarCompletedExerciseItem">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding ExerciseName}"
                                                           TextColor="{DynamicResource KineticText}"
                                                           FontSize="13"
                                                           FontAttributes="Bold" />
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SetsSummary}" Spacing="2">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Label Text="{Binding .}"
                                                                       TextColor="{DynamicResource KineticTextSecondary}"
                                                                       FontSize="12" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Planned / Missed Exercises Preview -->
                                <Border IsVisible="{Binding HasPlannedExercises}"
                                        BackgroundColor="{DynamicResource KineticWell}"
                                        Stroke="{DynamicResource KineticBorderSubtle}"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,10">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlannedExercises}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="repo:PlannedExerciseItem">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding ExerciseName}"
                                                           TextColor="{DynamicResource KineticText}"
                                                           FontSize="13"
                                                           FontAttributes="Bold" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding PlanText}"
                                                           TextColor="{DynamicResource KineticVolt}"
                                                           FontSize="12"
                                                           FontAttributes="Bold" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Action Buttons -->
                                <Button IsVisible="{Binding CanViewDetails}"
                                        Text="Разбор тренировки (План / Факт) →"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWorkoutDetailCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SecondaryActionButton}"
                                        HeightRequest="42"
                                        FontSize="12"
                                        FontAttributes="Bold" />

                                <Button IsVisible="{Binding CanStart}"
                                        Text="▶ Начать тренировку"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartPlannedWorkoutCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource VoltButton}"
                                        HeightRequest="44"
                                        FontSize="13"
                                        FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Rest Day Card -->
            <Border IsVisible="{Binding IsRestDay}"
                    BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="{OnIdiom Phone=20, Desktop=28}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" MaximumWidthRequest="500">
                    <Label Text="Отдых или свободная тренировка"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="На этот день нет запланированных тренировок. Вы можете провести свободную тренировку."
                           TextColor="{DynamicResource KineticTextSecondary}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                    <Button Text="+ Начать свободную тренировку"
                            Command="{Binding StartFreeWorkoutCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="44"
                            FontSize="13"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
