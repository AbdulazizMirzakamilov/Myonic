<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             xmlns:models="clr-namespace:Myonic.Core.Models;assembly=Myonic.Core"
             x:Class="Myonic.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             x:Name="ThisPage"
             Title="Настройки"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,40" Spacing="20">

            <!-- 1. THEME SELECTION -->
            <VerticalStackLayout Spacing="8">
                <Label Text="ТЕМА ОФОРМЛЕНИЯ"
                       TextColor="{DynamicResource KineticTextMuted}"
                       FontSize="11"
                       FontAttributes="Bold"
                       Margin="4,0" />

                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Выберите стиль интерфейса:"
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <!-- Dark Theme Option -->
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDarkThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="🌙" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Тёмная"
                                           TextColor="{DynamicResource KineticText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Obsidian"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Light Theme Option -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLightThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="☀️" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Светлая"
                                           TextColor="{DynamicResource KineticText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Clean Slate"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- System Theme Option -->
                            <Border Grid.Column="2"
                                    BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectSystemThemeCommand}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="📱" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="Системная"
                                           TextColor="{DynamicResource KineticText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Авто"
                                           TextColor="{DynamicResource KineticTextMuted}"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 2. WORKOUT PREFERENCES -->
            <VerticalStackLayout Spacing="8">
                <Label Text="ТРЕНИРОВОЧНЫЙ ПРОЦЕСС"
                       TextColor="{DynamicResource KineticTextMuted}"
                       FontSize="11"
                       FontAttributes="Bold"
                       Margin="4,0" />

                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,6">
                    <VerticalStackLayout Spacing="0">
                        <!-- PR Badges -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Рекорды 🏆 PR"
                                       TextColor="{DynamicResource KineticText}"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="Мгновенное уведомление о новом рекорде"
                                       TextColor="{DynamicResource KineticTextSecondary}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding ShowPrBadges}"
                                    OnColor="{DynamicResource KineticVolt}"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource KineticBorderSubtle}" />

                        <!-- Vibration / Haptics -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Тактильный отклик"
                                       TextColor="{DynamicResource KineticText}"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="Виброотклик при фиксации подхода"
                                       TextColor="{DynamicResource KineticTextSecondary}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding SoundVibrationEnabled}"
                                    OnColor="{DynamicResource KineticVolt}"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 3. AI ANALYTICS MODULE -->
            <VerticalStackLayout Spacing="8">
                <Label Text="МОДУЛЬ ИИ-АНАЛИТИКИ (AI LAYER)"
                       TextColor="{DynamicResource KineticTextMuted}"
                       FontSize="11"
                       FontAttributes="Bold"
                       Margin="4,0" />

                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Аналитическая ИИ-сводка"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="Разбор тренировок и динамики силового прогресса. Поддерживаются Google Gemini, OpenAI, DeepSeek, Groq, Qwen, Mistral, NVIDIA, Kimi, Zhipu и любые совместимые модели."
                                   TextColor="{DynamicResource KineticTextSecondary}"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Provider Selection -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Провайдер ИИ:"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,0">
                                <Picker ItemsSource="{Binding Providers}"
                                        SelectedIndex="{Binding SelectedProviderIndex}"
                                        TextColor="{DynamicResource KineticVolt}"
                                        TitleColor="{DynamicResource KineticTextMuted}"
                                        FontSize="13"
                                        HeightRequest="42" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- API Key Input -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="API-ключ:"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border BackgroundColor="{DynamicResource KineticWell}"
                                        Stroke="{DynamicResource KineticBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,0">
                                    <Entry Text="{Binding GeminiApiKey}"
                                           IsPassword="{Binding IsApiKeyObfuscated}"
                                           Placeholder="Вставьте API-ключ..."
                                           PlaceholderColor="{DynamicResource KineticTextMuted}"
                                           TextColor="{DynamicResource KineticText}"
                                           FontSize="13"
                                           HeightRequest="42"
                                           VerticalOptions="Center" />
                                </Border>
                                <Button Grid.Column="1"
                                        Text="{Binding ApiKeyVisibilityIcon}"
                                        Command="{Binding ToggleApiKeyVisibilityCommand}"
                                        Style="{StaticResource SecondaryActionButton}"
                                        WidthRequest="46"
                                        HeightRequest="42"
                                        Padding="0"
                                        FontSize="16" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Model Selection & Custom Name Entry -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Модель ИИ (выберите или введите любую):"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                <Entry Text="{Binding SelectedModel}"
                                       Placeholder="Например, gemini-2.5-flash, gemini-4-argon, gpt-4o, deepseek-chat"
                                       PlaceholderColor="{DynamicResource KineticTextMuted}"
                                       TextColor="{DynamicResource KineticVolt}"
                                       FontSize="13"
                                       HeightRequest="42"
                                       VerticalOptions="Center" />
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Text="Быстрый выбор:"
                                       TextColor="{DynamicResource KineticTextMuted}"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        BackgroundColor="{DynamicResource KineticWell}"
                                        Stroke="{DynamicResource KineticBorderSubtle}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,0">
                                    <Picker ItemsSource="{Binding AvailableModels}"
                                            SelectedItem="{Binding SelectedModel}"
                                            TextColor="{DynamicResource KineticTextSecondary}"
                                            Title="Рекомендуемые модели"
                                            TitleColor="{DynamicResource KineticTextMuted}"
                                            FontSize="12"
                                            HeightRequest="36" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Base URL (for Custom or specific endpoints) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsCustomBaseUrl}">
                            <Label Text="Базовый адрес API (Base URL):"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="{DynamicResource KineticWell}"
                                    Stroke="{DynamicResource KineticBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                <Entry Text="{Binding BaseUrl}"
                                       Placeholder="http://localhost:11434/v1"
                                       PlaceholderColor="{DynamicResource KineticTextMuted}"
                                       TextColor="{DynamicResource KineticText}"
                                       FontSize="13"
                                       HeightRequest="42"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Buttons: Save & Test -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="💾 Сохранить настройки"
                                    Command="{Binding SaveAiSettingsCommand}"
                                    Style="{StaticResource VoltButton}"
                                    HeightRequest="42"
                                    FontSize="12" />

                            <Button Grid.Column="1"
                                    Text="⚡ Проверить связь"
                                    Command="{Binding TestAiConnectionCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    HeightRequest="42"
                                    FontSize="12" />
                        </Grid>

                        <!-- Testing Activity Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsTestingConnection}"
                                           IsVisible="{Binding IsTestingConnection}"
                                           Color="{DynamicResource KineticVolt}"
                                           HeightRequest="24" />

                        <!-- Connection Test Feedback -->
                        <Border IsVisible="{Binding HasConnectionTestResult}"
                                BackgroundColor="{DynamicResource KineticWell}"
                                Stroke="{DynamicResource KineticBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,10">
                            <Label Text="{Binding ConnectionTestMessage}"
                                   TextColor="{DynamicResource KineticText}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </Border>

                        <Label Text="🔒 Ключ и параметры сохраняются локально на вашем устройстве и направляются напрямую выбранному сервису без посредников."
                               TextColor="{DynamicResource KineticTextMuted}"
                               FontSize="11" />

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 4. DATABASE & BACKUP -->
            <VerticalStackLayout Spacing="8">
                <Label Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ И ЭКСПОРТ (JSON / SQLITE)"
                       TextColor="{DynamicResource KineticTextMuted}"
                       FontSize="11"
                       FontAttributes="Bold"
                       Margin="4,0" />

                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="{DynamicResource KineticBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <!-- Database size info -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Локальная база данных SQLite"
                                       TextColor="{DynamicResource KineticText}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding DatabasePathText}"
                                       TextColor="{DynamicResource KineticTextMuted}"
                                       FontSize="10"
                                       LineBreakMode="MiddleTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding DatabaseSizeText}"
                                   TextColor="{DynamicResource KineticVolt}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource KineticBorderSubtle}" />

                        <!-- Create SQLite Backup Button -->
                        <Button Text="💾 Создать резервную копию базы (.db3)"
                                Command="{Binding CreateSqliteBackupCommand}"
                                Style="{StaticResource VoltButton}"
                                HeightRequest="44"
                                FontSize="13" />

                        <!-- Export / Import JSON Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="📤 Экспорт в JSON"
                                    Command="{Binding ExportJsonCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    HeightRequest="42"
                                    FontSize="12" />

                            <Button Grid.Column="1"
                                    Text="📥 Импорт из JSON"
                                    Command="{Binding ImportJsonCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    HeightRequest="42"
                                    FontSize="12" />
                        </Grid>

                        <!-- Backups List Section -->
                        <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                            <Label Text="СОХРАНЁННЫЕ КОПИИ В ПАПКЕ BACKUPS"
                                   TextColor="{DynamicResource KineticTextMuted}"
                                   FontSize="10"
                                   FontAttributes="Bold" />

                            <!-- List of backup files -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Backups}"
                                                 Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:BackupFileInfo">
                                        <Border BackgroundColor="{DynamicResource KineticWell}"
                                                Stroke="{DynamicResource KineticBorderSubtle}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12,10">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding FileName}"
                                                           TextColor="{DynamicResource KineticText}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="MiddleTruncation" />
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding DateFormatted}"
                                                               TextColor="{DynamicResource KineticTextMuted}"
                                                               FontSize="10" />
                                                        <Label Text="•" TextColor="{DynamicResource KineticTextMuted}" FontSize="10" />
                                                        <Label Text="{Binding SizeFormatted}"
                                                               TextColor="{DynamicResource KineticVolt}"
                                                               FontSize="10"
                                                               FontAttributes="Bold" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>

                                                <!-- Share Button -->
                                                <Button Grid.Column="1"
                                                        Text="📤"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ShareBackupCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        Padding="0"
                                                        FontSize="14"
                                                        VerticalOptions="Center" />

                                                <!-- Restore Button -->
                                                <Button Grid.Column="2"
                                                        Text="Восстановить"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RestoreBackupCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        HeightRequest="36"
                                                        Padding="10,0"
                                                        FontSize="11"
                                                        VerticalOptions="Center" />

                                                <!-- Delete Button -->
                                                <Button Grid.Column="3"
                                                        Text="✕"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteBackupCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        TextColor="Red"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        Padding="0"
                                                        FontSize="12"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 5. DANGER ZONE -->
            <VerticalStackLayout Spacing="8">
                <Label Text="ОПАСНАЯ ЗОНА (DANGER ZONE)"
                       TextColor="#EF4444"
                       FontSize="11"
                       FontAttributes="Bold"
                       Margin="4,0" />

                <Border BackgroundColor="{DynamicResource KineticSurface}"
                        Stroke="#7F1D1D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Очистка пользовательских данных"
                               TextColor="{DynamicResource KineticText}"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Удаляет все завершённые тренировки, зафиксированные подходы, программы, замеры тела и цели. Базовый справочник упражнений сохраняется."
                               TextColor="{DynamicResource KineticTextSecondary}"
                               FontSize="12" />

                        <Button Text="⚠️ Очистить все данные тренировок"
                                Command="{Binding ClearAllDataCommand}"
                                Style="{StaticResource SecondaryActionButton}"
                                TextColor="#EF4444"
                                HeightRequest="44"
                                FontSize="13"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- 6. ABOUT APP -->
            <Border BackgroundColor="{DynamicResource KineticSurface}"
                    Stroke="{DynamicResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Myonic – Силовой трекер"
                           TextColor="{DynamicResource KineticText}"
                           FontSize="15"
                           FontAttributes="Bold" />
                    <Label Text="Версия 1.0 (MVP) • .NET 10 MAUI • SQLite-net"
                           TextColor="{DynamicResource KineticTextMuted}"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
