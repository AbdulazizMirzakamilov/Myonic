<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myonic.ViewModels"
             x:Class="Myonic.Pages.ActiveWorkoutPage"
             x:DataType="vm:ActiveWorkoutViewModel"
             x:Name="ThisPage"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource KineticCanvas}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,40" Spacing="16">

            <!-- Top Session Status Bar -->
            <Border BackgroundColor="{StaticResource KineticSurface}"
                    Stroke="{StaticResource KineticBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Title}"
                               TextColor="{StaticResource KineticText}"
                               FontSize="19"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding DurationText, StringFormat='Время: {0}'}"
                               TextColor="{StaticResource KineticVolt}"
                               FontSize="14"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Завершить"
                            Command="{Binding FinishSessionCommand}"
                            Style="{StaticResource VoltButton}"
                            HeightRequest="44"
                            Padding="16,0"
                            FontSize="13" />
                </Grid>
            </Border>

            <!-- Quick Add Exercise Button -->
            <Button Text="+ Добавить упражнение"
                    Command="{Binding AddExerciseCommand}"
                    Style="{StaticResource SecondaryActionButton}"
                    HeightRequest="46"
                    FontSize="14"
                    FontAttributes="Bold" />

            <!-- Exercises Collection (BindableLayout - zero nested RecyclerView lag) -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActiveExerciseViewModel">
                        <Border x:Name="ExerciseCard"
                                BackgroundColor="{StaticResource KineticSurface}"
                                Stroke="{StaticResource KineticBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">

                                <!-- Exercise header & plan + View History + Delete Exercise Button -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ViewHistoryCommand}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding ExerciseName}"
                                               TextColor="{StaticResource KineticVolt}"
                                               FontSize="17"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding PlanText}"
                                               TextColor="{StaticResource KineticTextSecondary}"
                                               FontSize="13" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Button Text="История"
                                                Command="{Binding ViewHistoryCommand}"
                                                BackgroundColor="{StaticResource KineticWell}"
                                                TextColor="{StaticResource KineticIceBlue}"
                                                BorderColor="{StaticResource KineticBorderSubtle}"
                                                BorderWidth="1"
                                                CornerRadius="8"
                                                Padding="10,0"
                                                HeightRequest="32"
                                                FontSize="11"
                                                FontAttributes="Bold" />
                                        <Button Text="✕"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveExerciseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource KineticWell}"
                                                TextColor="{StaticResource KineticTextMuted}"
                                                BorderColor="{StaticResource KineticBorderSubtle}"
                                                BorderWidth="1"
                                                CornerRadius="8"
                                                Padding="0"
                                                HeightRequest="32"
                                                WidthRequest="32"
                                                FontSize="14" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Completed sets list (BindableLayout) -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SetEntryItem">
                                            <Border BackgroundColor="{StaticResource KineticWell}"
                                                    Stroke="{StaticResource KineticBorderSubtle}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="12,8">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding SummaryText}"
                                                           TextColor="{StaticResource KineticText}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding IsPr}"
                                                            BackgroundColor="{StaticResource KineticSurface}"
                                                            Stroke="{StaticResource KineticVolt}"
                                                            StrokeThickness="1"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="6,2"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding PrBadgeText}"
                                                               TextColor="{StaticResource KineticVolt}"
                                                               FontSize="10"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Text="✕"
                                                            Command="{Binding Source={x:Reference ExerciseCard}, Path=BindingContext.DeleteSetCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{StaticResource KineticCrimson}"
                                                            Padding="0"
                                                            HeightRequest="28"
                                                            WidthRequest="28"
                                                            FontSize="13" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Add new set input row -->
                                <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Вес (кг)" TextColor="{StaticResource KineticTextMuted}" FontSize="11" />
                                        <Entry Text="{Binding NextWeightText}"
                                               Keyboard="Numeric"
                                               Placeholder="80"
                                               BackgroundColor="{StaticResource KineticWell}"
                                               TextColor="{StaticResource KineticText}"
                                               HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Повт." TextColor="{StaticResource KineticTextMuted}" FontSize="11" />
                                        <Entry Text="{Binding NextRepsText}"
                                               Keyboard="Numeric"
                                               Placeholder="8"
                                               BackgroundColor="{StaticResource KineticWell}"
                                               TextColor="{StaticResource KineticText}"
                                               HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label Text="RPE" TextColor="{StaticResource KineticTextMuted}" FontSize="11" />
                                        <Entry Text="{Binding NextRpeText}"
                                               Keyboard="Numeric"
                                               Placeholder="8.0"
                                               BackgroundColor="{StaticResource KineticWell}"
                                               TextColor="{StaticResource KineticText}"
                                               HeightRequest="42" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="3"
                                            Text="+ Сет"
                                            Command="{Binding AddSetCommand}"
                                            Style="{StaticResource VoltButton}"
                                            VerticalOptions="End"
                                            Padding="14,0"
                                            HeightRequest="42"
                                            FontSize="13" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Discard button -->
            <Button Text="Отменить тренировку"
                    Command="{Binding DiscardSessionCommand}"
                    BackgroundColor="{StaticResource KineticWell}"
                    TextColor="{StaticResource KineticCrimson}"
                    BorderColor="{StaticResource KineticCrimson}"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="46"
                    FontSize="14"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
