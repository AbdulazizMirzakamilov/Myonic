<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Kinetic Obsidian Palette -->
    <Color x:Key="KineticCanvas">#0F1115</Color>
    <Color x:Key="KineticSurface">#171A21</Color>
    <Color x:Key="KineticWell">#1F242D</Color>
    <Color x:Key="KineticSurfaceHigh">#282A2E</Color>
    <Color x:Key="KineticBorder">#2A313E</Color>
    <Color x:Key="KineticBorderSubtle">#232832</Color>

    <Color x:Key="KineticVolt">#CCFF00</Color>
    <Color x:Key="KineticVoltMuted">#9AC600</Color>
    <Color x:Key="KineticVoltText">#0F1115</Color>

    <Color x:Key="KineticEmerald">#10B981</Color>
    <Color x:Key="KineticIceBlue">#38BDF8</Color>
    <Color x:Key="KineticCrimson">#FF385C</Color>

    <Color x:Key="KineticText">#FFFFFF</Color>
    <Color x:Key="KineticTextSecondary">#94A3B8</Color>
    <Color x:Key="KineticTextMuted">#64748B</Color>

    <SolidColorBrush x:Key="KineticCanvasBrush" Color="{StaticResource KineticCanvas}"/>
    <SolidColorBrush x:Key="KineticSurfaceBrush" Color="{StaticResource KineticSurface}"/>
    <SolidColorBrush x:Key="KineticWellBrush" Color="{StaticResource KineticWell}"/>
    <SolidColorBrush x:Key="KineticBorderBrush" Color="{StaticResource KineticBorder}"/>
    <SolidColorBrush x:Key="KineticVoltBrush" Color="{StaticResource KineticVolt}"/>
    <SolidColorBrush x:Key="KineticEmeraldBrush" Color="{StaticResource KineticEmerald}"/>
    <SolidColorBrush x:Key="KineticIceBlueBrush" Color="{StaticResource KineticIceBlue}"/>
    <SolidColorBrush x:Key="KineticCrimsonBrush" Color="{StaticResource KineticCrimson}"/>
    <SolidColorBrush x:Key="KineticTextBrush" Color="{StaticResource KineticText}"/>
    <SolidColorBrush x:Key="KineticTextSecondaryBrush" Color="{StaticResource KineticTextSecondary}"/>
    <SolidColorBrush x:Key="KineticTextMutedBrush" Color="{StaticResource KineticTextMuted}"/>

    <!-- Backward-compatible legacy tokens mapped to Kinetic Obsidian dark palette -->
    <Color x:Key="Primary">#CCFF00</Color>
    <Color x:Key="PrimaryDark">#CCFF00</Color>
    <Color x:Key="PrimaryDarkText">#0F1115</Color>
    <Color x:Key="Secondary">#171A21</Color>
    <Color x:Key="SecondaryDarkText">#E2E2E8</Color>
    <Color x:Key="Tertiary">#10B981</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0F1115</Color>
    <Color x:Key="Magenta">#CCFF00</Color>
    <Color x:Key="MidnightBlue">#171A21</Color>
    <Color x:Key="OffBlack">#0F1115</Color>

    <Color x:Key="Gray100">#E2E2E8</Color>
    <Color x:Key="Gray200">#94A3B8</Color>
    <Color x:Key="Gray300">#64748B</Color>
    <Color x:Key="Gray400">#475569</Color>
    <Color x:Key="Gray500">#2A313E</Color>
    <Color x:Key="Gray600">#1F242D</Color>
    <Color x:Key="Gray900">#171A21</Color>
    <Color x:Key="Gray950">#0F1115</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
