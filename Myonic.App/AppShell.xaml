<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Myonic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Myonic.Pages"
    Title="Myonic">

    <TabBar>
        <ShellContent
            Title="График"
            ContentTemplate="{DataTemplate pages:SchedulePage}"
            Route="SchedulePage" />
        <ShellContent
            Title="Программы"
            ContentTemplate="{DataTemplate pages:ProgramsPage}"
            Route="ProgramsPage" />
        <ShellContent
            Title="Упражнения"
            ContentTemplate="{DataTemplate pages:ExercisesPage}"
            Route="ExercisesPage" />
        <ShellContent
            Title="1ПМ"
            ContentTemplate="{DataTemplate pages:OneRepMaxPage}"
            Route="OneRepMaxPage" />
    </TabBar>
</Shell>
